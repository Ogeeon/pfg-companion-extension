{
  "manifest_version": 3,
  "name": "PfG Companion",
  "version": "0.1.1",
  "description": "Collect OGame account data while you play and make it available to ProxyForGame.",
  "browser_specific_settings": {
    "gecko": {
      "id": "companion@proxyforgame.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["websiteContent"],
        "optional": []
      }
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.ogame.gameforge.com/game/index.php*"],
      "js": ["src/main-world.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.ogame.gameforge.com/game/index.php*"],
      "js": ["src/i18n.js", "src/core.js", "src/bridge.js", "src/game.js", "src/panel.js", "src/game-main.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://proxyforgame.com/*", "https://www.proxyforgame.com/*"],
      "js": ["src/i18n.js", "src/core.js", "src/site-main.js"],
      "run_at": "document_idle"
    }
  ]
}
